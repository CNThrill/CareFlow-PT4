<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CareFlow.ViewModels"
        xmlns:dto="using:CareFlow.DTOs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
        Width="1100" Height="750" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        x:Class="CareFlow.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="CareFlow - Outpatient Diagnostic Booking Management">

    <!-- PALETTE ROLES:
         • Medical Teal (#0D9488): Primary color for main booking buttons, active steps, and brand trust.
         • Deep Slate Navy (#0F172A): High-contrast dark tone for headers, patient data, and primary text.
         • Soft Ice Blue (#F0F9FF): Clean, soothing tint for appointment cards, sidebars, and form backgrounds.
         • Pure White (#FFFFFF): Main canvas background to keep schedules and test lists sterile and readable.
    -->

    <Window.Styles>
        <!-- Glassmorphism Appointment Card: Soft Ice Blue Frosted Tint with Soft Glass Rim -->
        <Style Selector="Border.glass-card">
            <Setter Property="Background" Value="#EBF8FF" />
            <Setter Property="BorderBrush" Value="#BAE6FD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="0 6 24 0 #150F172A" />
        </Style>

        <!-- Glassmorphism Nested Panel: Pure White Sterile Panel -->
        <Style Selector="Border.glass-inner">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BoxShadow" Value="0 2 8 0 #0A0F172A" />
        </Style>

        <!-- Medical Teal (#0D9488) Primary Button: Guaranteed Non-Disappearing Hover -->
        <Style Selector="Button.glass-primary">
            <Setter Property="Background" Value="#0D9488" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#0F766E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.glass-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0F766E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#115E59" />
        </Style>
        <Style Selector="Button.glass-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#134E4A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#042F2E" />
        </Style>

        <!-- Scenario Verification AC-04 Button: Medical Teal (#0D9488) -->
        <Style Selector="Button.glass-teal-action">
            <Setter Property="Background" Value="#0D9488" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#0F766E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.glass-teal-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0F766E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#115E59" />
        </Style>
        <Style Selector="Button.glass-teal-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#134E4A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Scenario Verification AC-05 Button: Deep Slate Navy (#0F172A) High Contrast -->
        <Style Selector="Button.glass-navy-action">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#1E293B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.glass-navy-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#334155" />
        </Style>
        <Style Selector="Button.glass-navy-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#334155" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Subtle Button: Pure White (#FFFFFF) with Deep Slate Navy (#0F172A) text -->
        <Style Selector="Button.glass-subtle">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.glass-subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0F9FF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#0D9488" />
        </Style>
        <Style Selector="Button.glass-subtle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E0F2FE" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <!-- TabItem Styling -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#0D9488" />
            <Setter Property="Opacity" Value="1.0" />
        </Style>
    </Window.Styles>

    <!-- Pure White (#FFFFFF) Sterile Canvas with Soft Ice Blue Ambient Light -->
    <Panel Background="#FFFFFF">
        <!-- Ambient Decorative Layer -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="500" Height="500" Canvas.Left="-120" Canvas.Top="-150" Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0.0" Color="#F0F9FF" />
                        <GradientStop Offset="1.0" Color="Transparent" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="600" Height="600" Canvas.Right="-150" Canvas.Bottom="-150" Opacity="0.18">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0.0" Color="#CCFBF1" />
                        <GradientStop Offset="1.0" Color="Transparent" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Main Layout -->
        <Grid RowDefinitions="Auto,*">
            <!-- Header Bar: Soft Ice Blue (#F0F9FF) with Medical Teal (#0D9488) Accent -->
            <Border Grid.Row="0" Margin="16,14,16,8" Classes="glass-card" Padding="20,16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="CareFlow" FontSize="23" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                            <Border Background="#0D9488" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
                                <TextBlock Text="Hospital Diagnostics" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Outpatient Multi-Service Booking Management • Relational Transaction Coordination"
                                   FontSize="12.5" Foreground="#0F172A" Opacity="0.8" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Navigation Tabs -->
            <TabControl Grid.Row="1" Margin="16,4,16,16">
                <!-- ========================================================= -->
                <!-- TAB 1: NEW BOOKING                                        -->
                <!-- ========================================================= -->
                <TabItem Header="Book Diagnostic Services">
                    <ScrollViewer Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                            
                            <!-- Instruction Card: Soft Ice Blue (#F0F9FF) -->
                            <Border Classes="glass-card" Padding="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Schedule New Diagnostic Appointment" FontWeight="Bold" FontSize="15" Foreground="#0D9488" />
                                    <TextBlock Text="Hospital Booking Rules: Each request must reference an existing patient and contain 1 to 3 distinct diagnostic services. If any requested service is full for that date, the transaction rejects the entire request atomically."
                                               TextWrapping="Wrap" FontSize="12.5" Foreground="#0F172A" Opacity="0.85" />
                                </StackPanel>
                            </Border>

                            <!-- Feedback Banners -->
                            <StackPanel IsVisible="{Binding NewBooking.HasMessage}">
                                <!-- Success Message: Medical Teal (#0D9488) -->
                                <Border IsVisible="{Binding NewBooking.IsSuccessMessage}"
                                        Background="#0D9488" BorderBrush="#0F766E" BorderThickness="1"
                                        CornerRadius="10" Padding="16" BoxShadow="0 4 16 0 #200D9488">
                                    <TextBlock Text="{Binding NewBooking.StatusMessage}"
                                               Foreground="#FFFFFF" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13" />
                                </Border>

                                <!-- Error Message: Soft Ice Blue (#F0F9FF) with Deep Slate Navy Text and Teal Accent -->
                                <Border IsVisible="{Binding !NewBooking.IsSuccessMessage}"
                                        Background="#F0F9FF" BorderBrush="#0D9488" BorderThickness="1.5"
                                        CornerRadius="10" Padding="16" BoxShadow="0 4 16 0 #150F172A">
                                    <TextBlock Text="{Binding NewBooking.StatusMessage}"
                                               Foreground="#0F172A" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13" />
                                </Border>
                            </StackPanel>

                            <!-- Form Background: Soft Ice Blue (#F0F9FF) Card with Pure White (#FFFFFF) Inputs -->
                            <Border Classes="glass-card" Padding="20">
                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto">
                                        <!-- Patient Selection -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Select Patient:"
                                                   FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,16" />
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding NewBooking.Patients}"
                                                  SelectedItem="{Binding NewBooking.SelectedPatient}"
                                                  HorizontalAlignment="Stretch" Margin="0,0,0,16">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="dto:PatientDto">
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="#0F172A" />
                                                        <TextBlock Text="{Binding ContactNumber}" Foreground="#475569" />
                                                        <TextBlock Text="{Binding DateOfBirth, StringFormat='DOB: {0:yyyy-MM-dd}'}" Foreground="#64748B" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Booking Date -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Booking Date:"
                                                   FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,16" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="14" Margin="0,0,0,16">
                                            <DatePicker SelectedDate="{Binding NewBooking.BookingDate}" VerticalAlignment="Center" />
                                            <Button Classes="glass-subtle" Content="Check Availability"
                                                    Command="{Binding NewBooking.RefreshServicesAvailabilityCommand}"
                                                    VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Diagnostic Services Selection -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Diagnostic Services:"
                                                   FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Top" Margin="0,8,10,0" />
                                        <Border Grid.Row="2" Grid.Column="1" Classes="glass-inner" Padding="14">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Select 1 to 3 distinct services for this appointment (BR-02):"
                                                           FontSize="12" Foreground="#475569" Margin="0,0,0,4" />

                                                <ItemsControl ItemsSource="{Binding NewBooking.Services}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SelectableServiceItemViewModel">
                                                            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1"
                                                                    CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
                                                                <Grid ColumnDefinitions="Auto,65,*,Auto">
                                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEnabled}" VerticalAlignment="Center" />
                                                                    
                                                                    <Border Grid.Column="1" Background="#0D9488" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                                                                    </Border>
                                                                    
                                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" />
                                                                        <TextBlock Text="{Binding RemainingCapacity, StringFormat='Daily Capacity: {0} spots remaining'}"
                                                                                   FontSize="11" Foreground="#475569" />
                                                                    </StackPanel>

                                                                    <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="#BAE6FD" BorderThickness="1"
                                                                            CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayText}" FontSize="11" FontWeight="SemiBold" Foreground="#0D9488" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Main Booking Actions: Medical Teal (#0D9488) -->
                                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="150,18,0,0">
                                        <Button Classes="glass-primary"
                                                Content="Confirm Booking (Atomic Transaction)"
                                                Command="{Binding NewBooking.SubmitBookingCommand}"
                                                IsEnabled="{Binding !NewBooking.IsBusy}" />

                                        <Button Classes="glass-subtle"
                                                Content="Clear Selection"
                                                Command="{Binding NewBooking.ClearSelectionCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========================================================= -->
                <!-- TAB 2: SERVICE DAILY AVAILABILITY                         -->
                <!-- ========================================================= -->
                <TabItem Header="Daily Availability">
                    <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                        <!-- Toolbar -->
                        <Border Grid.Row="0" Classes="glass-card" Padding="14" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="Select Target Date:" FontWeight="SemiBold" Foreground="#0F172A"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <DatePicker Grid.Column="1" SelectedDate="{Binding Availability.SelectedDate}" VerticalAlignment="Center" />
                                <Button Grid.Column="3" Classes="glass-primary" Content="Refresh Capacity"
                                        Command="{Binding Availability.LoadAvailabilityCommand}" />
                            </Grid>
                        </Border>

                        <!-- Pure White (#FFFFFF) Table Container with Soft Ice Blue (#F0F9FF) Rows -->
                        <Border Grid.Row="1" Classes="glass-card" Padding="14">
                            <ScrollViewer>
                                <StackPanel Spacing="8">
                                    <!-- Table Header: Deep Slate Navy (#0F172A) Text -->
                                    <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <Grid ColumnDefinitions="80,*,120,120,140,130">
                                            <TextBlock Grid.Column="0" Text="Code" FontWeight="Bold" FontSize="12" Foreground="#0F172A" />
                                            <TextBlock Grid.Column="1" Text="Diagnostic Service Name" FontWeight="Bold" FontSize="12" Foreground="#0F172A" />
                                            <TextBlock Grid.Column="2" Text="Daily Quota" FontWeight="Bold" FontSize="12" Foreground="#0F172A" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="Booked" FontWeight="Bold" FontSize="12" Foreground="#0F172A" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="Remaining Spots" FontWeight="Bold" FontSize="12" Foreground="#0F172A" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="Status" FontWeight="Bold" FontSize="12" Foreground="#0F172A" HorizontalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Table Rows -->
                                    <ItemsControl ItemsSource="{Binding Availability.Services}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="dto:ServiceAvailabilityDto">
                                                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                                                        CornerRadius="6" Padding="14,11" Margin="0,2">
                                                    <Grid ColumnDefinitions="80,*,120,120,140,130">
                                                        <Border Grid.Column="0" Background="#0D9488" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding DailyCapacity}" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding BookedCount}" Foreground="#0F172A" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4" Text="{Binding RemainingCapacity}" Foreground="#0D9488" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        
                                                        <Border Grid.Column="5" HorizontalAlignment="Center" CornerRadius="6" Padding="10,3"
                                                                Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="#0D9488" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ========================================================= -->
                <!-- TAB 3: BOOKING HISTORY & DETAILS                          -->
                <!-- ========================================================= -->
                <TabItem Header="Booking History &amp; Details">
                    <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                        <Border Grid.Row="0" Classes="glass-card" Padding="14" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Confirmed Outpatient Diagnostic Records" FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="glass-subtle" Content="Refresh Records"
                                        Command="{Binding History.LoadBookingsCommand}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="450,*">
                            <!-- Left: Master List on Soft Ice Blue (#F0F9FF) Card -->
                            <Border Grid.Column="0" Classes="glass-card" Padding="10" Margin="0,0,12,0">
                                <ListBox ItemsSource="{Binding History.Bookings}"
                                         SelectedItem="{Binding History.SelectedBooking}"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="dto:BookingDetailDto">
                                            <Border Background="#FFFFFF" BorderBrush="#BAE6FD" BorderThickness="1"
                                                    CornerRadius="8" Padding="12,10" Margin="0,3">
                                                <StackPanel Spacing="3">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding ReferenceNumber}" FontWeight="Bold" FontSize="13" Foreground="#0D9488" />
                                                        <TextBlock Grid.Column="1" Text="{Binding BookingDate, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="11.5" Foreground="#64748B" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" />
                                                    <TextBlock Text="{Binding ServicesSummary}" FontSize="11" Foreground="#475569" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- Right: Booking Details Card on Pure White (#FFFFFF) Canvas -->
                            <Border Grid.Column="1" Classes="glass-card" Padding="20">
                                <ScrollViewer>
                                    <StackPanel Spacing="16">
                                        <!-- Header Reference -->
                                        <Border Classes="glass-inner" Padding="16">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <TextBlock Text="Booking Reference" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding History.SelectedBooking.ReferenceNumber}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#0D9488" CornerRadius="6" Padding="12,4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding History.SelectedBooking.Status}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Patient Info -->
                                        <Border Classes="glass-inner" Padding="16">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Patient Details" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Full Name:" Foreground="#64748B" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding History.SelectedBooking.PatientName}" FontWeight="SemiBold" Foreground="#0F172A" />
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Scheduled Date:" Foreground="#64748B" Margin="0,8,0,0" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding History.SelectedBooking.BookingDate, StringFormat='{}{0:dddd, MMMM dd, yyyy}'}" FontWeight="SemiBold" Foreground="#0D9488" Margin="0,8,0,0" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Diagnostic Services -->
                                        <Border Classes="glass-inner" Padding="16">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Included Diagnostic Tests" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                                                <ItemsControl ItemsSource="{Binding History.SelectedBooking.ServiceNames}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1"
                                                                    CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                    <TextBlock Text="•" Foreground="#0D9488" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{Binding History.SelectedBooking.CreatedAt, StringFormat='Relational Transaction Recorded: {0:yyyy-MM-dd hh:mm:ss tt} PST'}"
                                                   FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ========================================================= -->
                <!-- TAB 4: SCENARIO VERIFICATION (NEVER DISAPPEARING BUTTONS) -->
                <!-- ========================================================= -->
                <TabItem Header="Scenario Verification">
                    <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                        <!-- Controls Card -->
                        <Border Grid.Row="0" Classes="glass-card" Padding="16" Margin="0,0,0,12">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Interactive Acceptance Verification (AC-04 Stale Recheck &amp; AC-05 Atomic Rollback)"
                                           FontWeight="Bold" FontSize="14.5" Foreground="#0D9488" />
                                <TextBlock Text="Execute live transactional test scenarios against the SQLite database and monitor atomic rollback behavior in the audit console below."
                                           FontSize="12" Foreground="#0F172A" Opacity="0.85" />

                                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                                    <!-- AC-04 Button: Medical Teal (#0D9488) (hover guaranteed visible) -->
                                    <Button Classes="glass-teal-action"
                                            Content="Run AC-04 (Stale Availability Recheck)"
                                            Command="{Binding Verification.RunScenarioAC04_StaleAvailabilityCommand}"
                                            IsEnabled="{Binding !Verification.IsRunning}" />

                                    <!-- AC-05 Button: Deep Slate Navy (#0F172A) (hover guaranteed visible) -->
                                    <Button Classes="glass-navy-action"
                                            Content="Run AC-05 (Transaction Rollback Demo)"
                                            Command="{Binding Verification.RunScenarioAC05_TransactionRollbackCommand}"
                                            IsEnabled="{Binding !Verification.IsRunning}" />

                                    <!-- Clear Log Button -->
                                    <Button Classes="glass-subtle"
                                            Content="Clear Console"
                                            Command="{Binding Verification.ClearLogCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Deep Slate Navy (#0F172A) High-Contrast Audit Console -->
                        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#0D9488" BorderThickness="1"
                                CornerRadius="12" Padding="16" BoxShadow="0 8 30 0 #250F172A">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" Text="Live Transaction &amp; Database Engine Audit Stream:"
                                           FontFamily="Consolas, monospace" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8" />
                                <TextBox Grid.Row="1"
                                         Text="{Binding Verification.VerificationLog}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         FontFamily="Consolas, monospace"
                                         FontSize="12.5"
                                         Foreground="#2DD4BF"
                                         Background="#0F172A"
                                         BorderThickness="0" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Panel>
</Window>
